{
    "name": "phalcon/crest",
    "description": "Command line application for Phalcon",
    "type": "library",
    "license": "BSD-3-Clause",
    "keywords": ["phalcon", "cli", "console", "generator", "scaffolding"],
    "require": {
        "php": "^8.1",
        "phalcon/cli-options-parser": "^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3",
        "pds/composer-script-names": "^1",
        "pds/skeleton": "^1",
        "phalcon/phalcon": "^6.0@beta",
        "phalcon/talon": "^0.8",
        "phpstan/phpstan": "^2",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3 || ^4"
    },
    "suggest": {
        "ext-phalcon": "Phalcon C extension (^5) - alternative to the phalcon/phalcon package"
    },
    "autoload": {
        "psr-4": { "Crest\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Crest\\Tests\\": "tests/" }
    },
    "bin": ["bin/crest"],
    "config": {
        "sort-packages": true,
        "allow-plugins": { "pds/skeleton": false },
        "platform": { "php": "8.1.0" }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "archive": {
        "exclude": [
            "/.github",
            "/resources/docker",
            "/resources/phpcs.xml",
            "/resources/phpstan.neon",
            "/resources/php-cs-fixer.php",
            "/resources/phpunit.xml.dist",
            "/resources/.env.example",
            "/tests",
            "docker-compose.yml"
        ]
    },
    "scripts": {
        "analyze": "phpstan analyse -c resources/phpstan.neon",
        "cs": "phpcs --standard=resources/phpcs.xml",
        "cs-fix": "phpcbf --standard=resources/phpcs.xml",
        "cs-fixer": "php-cs-fixer fix --config=resources/php-cs-fixer.php --dry-run --diff",
        "cs-fixer-fix": "php-cs-fixer fix --config=resources/php-cs-fixer.php",
        "test": "@php vendor/bin/talon run",
        "test-coverage": "@php vendor/bin/talon run unit -- --coverage-clover tests/_output/coverage.xml",
        "test-coverage-html": "@php vendor/bin/talon run unit -- --coverage-html tests/_output/coverage"
    }
}
