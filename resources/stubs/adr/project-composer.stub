{
    "type": "project",
    "require": {
        "php": ">={{ phpVersion }}",
        "{{ phalconPackage }}": "{{ phalconConstraint }}"
    },
    "require-dev": {
        "phalcon/crest": "{{ crestConstraint }}"
    },
    "autoload": {
        "psr-4": {
            "{{ jsonNamespace }}\\": "{{ source }}/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
