<?php

/**
 * Router for PHP's built-in server: php -S localhost:8080 -t public .htrouter.php
 * A request for a real file under public/ gets that file. All other requests
 * go to the front controller.
 */

declare(strict_types=1);

$uri = urldecode((string) parse_url((string) $_SERVER['REQUEST_URI'], PHP_URL_PATH));

if ('/' !== $uri && true === file_exists(__DIR__ . '/public' . $uri)) {
    return false;
}

require_once __DIR__ . '/public/index.php';
