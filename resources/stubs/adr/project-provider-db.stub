<?php

declare(strict_types=1);

namespace {{ providerNamespace }};

use Phalcon\Contracts\Container\Service\Collection;
use Phalcon\Contracts\Container\Service\Provider as ProviderContract;
use Phalcon\DataMapper\Pdo\Connection;

/**
 * The database, through the data mapper: a Phalcon\DataMapper connection,
 * also named db. docker compose gives the values of .env to the app container.
 * PHP on the host does not read .env: there, the defaults apply, and they point
 * to the published port of the database container.
 */
final class DbProvider implements ProviderContract
{
    public function provide(Collection $services): void
    {
        $dsn      = sprintf(
            '{{ dsnDriver }}:host=%s;port=%s;dbname=%s{{ dsnCharset }}',
            self::env('DB_HOST', '127.0.0.1'),
            self::env('DB_PORT', '{{ databasePort }}'),
            self::env('DB_NAME', '{{ databaseName }}')
        );
        $username = self::env('DB_USERNAME', '{{ databaseUser }}');
        $password = self::env('DB_PASSWORD', 'secret');

        // The container calls the closure at the first get(), and keeps the
        // connection. The connection connects at its first query.
        $services->set(
            Connection::class,
            static function () use ($dsn, $username, $password): Connection {
                return new Connection($dsn, $username, $password);
            }
        );
        $services->setAlias(Connection::class, 'db');
    }

    /**
     * The real environment wins (the env_file of docker compose). $_ENV covers
     * a loader that does not call putenv(), such as phpdotenv.
     */
    private static function env(string $name, string $default): string
    {
        $value = getenv($name);

        if (false !== $value) {
            return $value;
        }

        return (string) ($_ENV[$name] ?? $default);
    }
}
