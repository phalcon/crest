{{ content() }}
<h1>Edit [[ model ]]</h1>

<form method="post" action="{{ url('[[ url ]]/save/' ~ id|url_encode) }}">
{% for element in form %}
    <p>{{ element.label() }} {{ element.render() }}</p>
{% endfor %}
    <button type="submit">Save</button>
</form>

<p><a href="{{ url('[[ url ]]') }}">Back to the list</a></p>
