<?php

declare(strict_types=1);

namespace {{ providerNamespace }};

use Phalcon\Db\Adapter\Pdo\{{ adapter }};
use Phalcon\Di\DiInterface;
use Phalcon\Di\ServiceProviderInterface;

/**
 * The database. docker compose gives the values of .env to the app container.
 * PHP on the host does not read .env: there, the defaults apply, and they point
 * to the published port of the database container.
 */
final class DbProvider implements ServiceProviderInterface
{
    public function register(DiInterface $di): void
    {
        $config = [
            'host'     => self::env('DB_HOST', '127.0.0.1'),
            'port'     => self::env('DB_PORT', '{{ databasePort }}'),
            'dbname'   => self::env('DB_NAME', '{{ databaseName }}'),
            'username' => self::env('DB_USERNAME', '{{ databaseUser }}'),
            'password' => self::env('DB_PASSWORD', 'secret'),
{{ charset }}        ];

        // Not a static closure: the container binds each closure to itself,
        // and a static closure gives a warning there.
        $di->setShared('db', function () use ($config): {{ adapter }} {
            return new {{ adapter }}($config);
        });
    }

    /**
     * The real environment wins (the env_file of docker compose). $_ENV covers
     * a loader that does not call putenv(), such as phpdotenv.
     */
    private static function env(string $name, string $default): string
    {
        $value = getenv($name);

        if (false !== $value) {
            return $value;
        }

        return (string) ($_ENV[$name] ?? $default);
    }
}
