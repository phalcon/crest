<?php

declare(strict_types=1);

namespace {{ providerNamespace }};

use Phalcon\Db\Adapter\Pdo\Sqlite;
use Phalcon\Di\DiInterface;
use Phalcon\Di\ServiceProviderInterface;

/**
 * The database: a SQLite file in the project. DB_NAME is relative to the
 * project root. docker compose gives the values of .env to the app container.
 * PHP on the host does not read .env: there, the default applies.
 */
final class DbProvider implements ServiceProviderInterface
{
    public function __construct(private readonly string $projectRoot)
    {
    }

    public function register(DiInterface $di): void
    {
        $config = [
            'dbname' => $this->projectRoot . '/' . self::env('DB_NAME', '{{ databaseFile }}'),
        ];

        // Not a static closure: the container binds each closure to itself,
        // and a static closure gives a warning there.
        $di->setShared('db', function () use ($config): Sqlite {
            return new Sqlite($config);
        });
    }

    /**
     * The real environment wins (the env_file of docker compose). $_ENV covers
     * a loader that does not call putenv(), such as phpdotenv.
     */
    private static function env(string $name, string $default): string
    {
        $value = getenv($name);

        if (false !== $value) {
            return $value;
        }

        return (string) ($_ENV[$name] ?? $default);
    }
}
