<?php

declare(strict_types=1);

namespace {{ providerNamespace }};

use Phalcon\Di\DiInterface;
use Phalcon\Di\ServiceProviderInterface;
use Phalcon\Mvc\Dispatcher;

/**
 * The dispatcher. It finds the controllers in {{ controllerNamespace }}.
 */
final class DispatcherProvider implements ServiceProviderInterface
{
    public function register(DiInterface $di): void
    {
        // Not a static closure: the container binds each closure to itself,
        // and a static closure gives a warning there.
        $di->setShared('dispatcher', function (): Dispatcher {
            $dispatcher = new Dispatcher();
            $dispatcher->setDefaultNamespace('{{ controllerNamespace }}');

            return $dispatcher;
        });
    }
}
