    /**
     * An input that is empty or has only whitespace is null, and the model
     * decides if the column can be null. The filters give 0 for an empty number.
     */
    public function afterBind(?object $entity): void
    {
        if (null === $entity) {
            return;
        }

        foreach ($this->data as $name => $value) {
            if (true === is_string($value) && '' === trim($value)) {
                $entity->{$name} = null;
            }
        }
    }

    /**
     * A Select makes false into '', and selects no option. An integer selects
     * the option 0.
     */
    public function getValue(string $name): mixed
    {
        $value = parent::getValue($name);

        return true === is_bool($value) ? (int) $value : $value;
    }
}
