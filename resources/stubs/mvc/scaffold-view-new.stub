<?= $this->getContent() ?>
<h1>New {{ model }}</h1>

<form method="post" action="<?= $this->url->get('{{ url }}/create') ?>">
<?php foreach ($form as $element): ?>
    <p><?= $element->label() ?> <?= $element->render() ?></p>
<?php endforeach; ?>
    <button type="submit">Save</button>
</form>

<p><a href="<?= $this->url->get('{{ url }}') ?>">Back to the list</a></p>
