parameters:
    level: max
    paths:
        - %currentWorkingDirectory%/src
        - %currentWorkingDirectory%/tests
    excludePaths:
        - %currentWorkingDirectory%/tests/_output
    bootstrapFiles:
        - %currentWorkingDirectory%/vendor/autoload.php
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # Registry::discover() checks for Composer 1 and early 2.0 releases.
        # phpstan sees only the Composer in vendor/, which has the method.
        -
            identifier: function.alreadyNarrowedType
            path: %currentWorkingDirectory%/src/Console/Registry.php
            count: 1
        # The test gives a SQLite key with no referenced columns as Phalcon
        # gave it before cphalcon 5.24.0: null in referencedColumns (#87).
        # Phalcon declares a list of strings.
        -
            identifier: argument.type
            path: %currentWorkingDirectory%/tests/Database/Generator/ModelRelationsSqliteTest.php
            count: 1
